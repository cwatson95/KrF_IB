%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   AUDIT SMOKE: pure Ne, single E/N point, reduced statistics
%   (validates the BSR state blocks before the production runs;
%    same pattern as krf0d/audit_smoke_Kr.in)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

workingConditions:
  gasPressure: 133.32            % Pa (swarm coeffs are E/N-normalised)
  gasTemperature: 300            % K
  reducedElecField: [50]         % in Td
  reducedMagField: 0
  elecFieldAngle: 180
  excitationFrequency: 0

electronKinetics:
  isOn: true
  eedfType: boltzmannMC
  ionizationOperatorType: equalSharing
  LXCatFiles:
    - Neon/Ne_LXCat_mt.txt
  gasProperties:
    mass: Databases/masses.txt
    fraction:
      - Ne = 1
    harmonicFrequency: Databases/harmonicFrequencies.txt
    anharmonicFrequency: Databases/anharmonicFrequencies.txt
    rotationalConstant: Databases/rotationalConstants.txt
    electricQuadrupoleMoment: Databases/quadrupoleMoment.txt
    OPBParameter: Databases/OPBParameter.txt
  stateProperties:
    population:
      - Ne(1S0) = 1
    statisticalWeight:
      - Ne(1S0) = 1
      - Ne(3s[3/2]2,1s5) = 5
      - Ne(3s[3/2]1,1s4) = 3
      - Ne(3s![1/2]0,1s3) = 1
      - Ne(3s![3/2]1,1s2) = 3
      - Ne(3p[1/2]1,2p10) = 3   % NOTE: unbalanced parenthesis is a typo in the original LXCat file; must match exactly
      - Ne(3p[5/2]3,2p9) = 7
      - Ne(3p[5/2]2,2p8) = 5    % NOTE: space before [5/2] is in the original LXCat file; must match exactly
      - Ne(3p[3/2]1,2p7) = 3
      - Ne(3p[3/2]2,2p6) = 5
      - Ne(3p![3/2]1,2p5) = 3
      - Ne(3p![3/2]2,2p4) = 5
      - Ne(3p[1/2]0,2p3) = 1
      - Ne(3p![1/2]1,2p2) = 3
      - Ne(3p![1/2]0,2p1) = 1
      - Ne(4s[3/2]2,2s5) = 5
      - Ne(4s[3/2]1,2s4) = 3
      - Ne(4s![1/2]0,2s3) = 1
      - Ne(4s![1/2]1,2s2) = 3
      - Ne(3d[1/2]0,3d6) = 1
      - Ne(3d[1/2]1,3d5) = 3
      - Ne(3d[7/2]3,3d4) = 7
      - Ne(3d[7/2]4,3d4!) = 9
      - Ne(3d[3/2]2,3d3) = 5
      - Ne(3d[3/2]1,3d2) = 3
      - Ne(3d[5/2]2,3d1!!) = 5
      - Ne(3d[5/2]3,3d1!) = 7
      - Ne(3d![5/2]2,3s1!!!!) = 5
      - Ne(3d![5/2]3,3s1!!!) = 7
      - Ne(3d![3/2]2,3s1!!) = 5
      - Ne(3d![3/2]1,3s1!) = 3
      - Ne(2p6) = 1               % Ne ground state ion (ionization process)
  numericsMC:
    nElectrons: 5E3
    gasTemperatureEffect: smartActivation
    nIntegrationPoints: 1E4
    nIntegratedSSTimes: 3

chemistry:
  isOn: false

gui:
  isOn: false

output:
  isOn: true
  folder: audit_smoke_Ne
  dataFiles:
    - eedf
    - swarmParameters
    - rateCoefficients
    - powerBalance
    - lookUpTable
