%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   Ne-buffer swarm analysis at the GUI_v2 operating point (PLAN (30))
%   Kr/F2/Ne = 0.05/0.001/0.949  — Ne fills the buffer remainder
%   Grid spans the device drive regimes: 0.5 Td (sustainer),
%   ~20 Td (KrF*-precursor peak), 150 Td (microwave), 300 Td (avalanche)
%   Companion control run: V2_F2001_Ar949_Kr050.in (Ramsauer buffer)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

workingConditions:
  gasPressure: 133.32            % Pa (swarm coeffs are E/N-normalised)
  gasTemperature: 300            % K
  reducedElecField: [5,10,15,20,25,30,40,50,60,80,100,150,200,300]      % in Td
  % near-thermal points (0.5-3 Td) split into V2_F2001_Ne949_Kr050_lowEN.in:
  % single-point MC convergence there runs 30-60+ min (slow elastic energy
  % relaxation), and would serialize behind the whole fast grid
  reducedMagField: 0
  elecFieldAngle: 180
  excitationFrequency: 0

electronKinetics:
  isOn: true
  eedfType: boltzmannMC
  ionizationOperatorType: equalSharing
  LXCatFiles:
    - Krypton/Kr_LXCat.txt
    - Fluorine2/F2_LXCat.txt
    - Neon/Ne_LXCat_mt.txt

  gasProperties:
    mass: Databases/masses.txt
    fraction:
      - Kr = 0.05
      - F2 = 0.001
      - F = 0            % attachment product species (declared, zero fraction — F2_swarm_setup.in pattern)
      - Ne = 0.949
    harmonicFrequency: Databases/harmonicFrequencies.txt
    anharmonicFrequency: Databases/anharmonicFrequencies.txt
    rotationalConstant: Databases/rotationalConstants.txt
    electricQuadrupoleMoment: Databases/quadrupoleMoment.txt
    OPBParameter: Databases/OPBParameter.txt

  stateProperties:
    population:
      - Kr(1S0) = 1
      - F2(V0) = 1
      - F(-,1s) = 0
      - F(2P) = 0
      - Ne(1S0) = 1
    statisticalWeight:
      - Kr(1S0) = 1
      - Ne(1S0) = 1
      - Ne(3s[3/2]2,1s5) = 5
      - Ne(3s[3/2]1,1s4) = 3
      - Ne(3s![1/2]0,1s3) = 1
      - Ne(3s![3/2]1,1s2) = 3
      - Ne(3p[1/2]1,2p10) = 3   % NOTE: unbalanced parenthesis is a typo in the original LXCat file; must match exactly
      - Ne(3p[5/2]3,2p9) = 7
      - Ne(3p[5/2]2,2p8) = 5    % NOTE: space before [5/2] is in the original LXCat file; must match exactly
      - Ne(3p[3/2]1,2p7) = 3
      - Ne(3p[3/2]2,2p6) = 5
      - Ne(3p![3/2]1,2p5) = 3
      - Ne(3p![3/2]2,2p4) = 5
      - Ne(3p[1/2]0,2p3) = 1
      - Ne(3p![1/2]1,2p2) = 3
      - Ne(3p![1/2]0,2p1) = 1
      - Ne(4s[3/2]2,2s5) = 5
      - Ne(4s[3/2]1,2s4) = 3
      - Ne(4s![1/2]0,2s3) = 1
      - Ne(4s![1/2]1,2s2) = 3
      - Ne(3d[1/2]0,3d6) = 1
      - Ne(3d[1/2]1,3d5) = 3
      - Ne(3d[7/2]3,3d4) = 7
      - Ne(3d[7/2]4,3d4!) = 9
      - Ne(3d[3/2]2,3d3) = 5
      - Ne(3d[3/2]1,3d2) = 3
      - Ne(3d[5/2]2,3d1!!) = 5
      - Ne(3d[5/2]3,3d1!) = 7
      - Ne(3d![5/2]2,3s1!!!!) = 5
      - Ne(3d![5/2]3,3s1!!!) = 7
      - Ne(3d![3/2]2,3s1!!) = 5
      - Ne(3d![3/2]1,3s1!) = 3
      - Ne(2p6) = 1               % Ne ground state ion (ionization process)

  numericsMC:
    nElectrons: 2E4
    gasTemperatureEffect: smartActivation
    nIntegrationPoints: 1E4
    nIntegratedSSTimes: 3

chemistry:
  isOn: false

gui:
  isOn: false

output:
  isOn: true
  folder: krf0d_V2_F2001_Ne949_Kr050
  dataFiles:
    - eedf
    - swarmParameters
    - rateCoefficients
    - powerBalance
    - lookUpTable
