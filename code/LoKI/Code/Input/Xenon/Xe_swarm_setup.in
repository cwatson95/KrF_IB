%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%    SWARM ANALYSIS XENON  %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% --- configuration of the working conditions ---
workingConditions:
  gasPressure: 133.32                         % in Pa
  gasTemperature: 300                         % in K
  reducedElecField: [20,50,100,300]      % in Td
  reducedMagField: 0                          % in Hx
  elecFieldAngle: 180                         % in degrees
  excitationFrequency: 0                      % in Hz

% --- configuration of the electron kinetics ---
electronKinetics:
  isOn: true             % true or false (to activate or deactivate the electron kinetics)
  eedfType: boltzmannMC    % boltzmann or prescribedEedf
  ionizationOperatorType: equalSharing % oneTakesAll, equalSharing, usingSDCS, randomUniform
  LXCatFiles:            % cross section files
    - Xenon/Xe_LXCat.txt
  gasProperties:        % properties of the gases (S.I. Units)
    mass: Databases/masses.txt
    fraction:
      - Xe = 1
    harmonicFrequency: Databases/harmonicFrequencies.txt
    anharmonicFrequency: Databases/anharmonicFrequencies.txt
    rotationalConstant: Databases/rotationalConstants.txt
    electricQuadrupoleMoment: Databases/quadrupoleMoment.txt
    OPBParameter: Databases/OPBParameter.txt
  stateProperties:      % properties of the states (S.I. Units except for the energy [eV])
    population:
      - Xe(1S0) = 1
    statisticalWeight:
      - Xe(1S0) = 1
      - Xe(6s[3/2]2,1s5) = 5
      - Xe(6s[3/2]1,1s4) = 3
      - Xe(6s![1/2]0,1s3) = 1
      - Xe(6s![1/2]1,1s2) = 3
      - Xe(6p[1/2]1) = 3
      - Xe(6p[5/2]2) = 5
      - Xe(6p[5/2]3) = 7
      - Xe(6p[3/2]1) = 3
      - Xe(6p[3/2]2) = 5
      - Xe(5d[1/2]0) = 1
      - Xe(5d[1/2]1) = 3
      - Xe(6p[1/2]0) = 1
      - Xe(5d[7/2]4) = 9
      - Xe(5d[3/2]2) = 5
      - Xe(5d[7/2]3) = 7
      - Xe(5d[5/2]2) = 5
      - Xe(5d[5/2]3) = 7
      - Xe(5d[3/2]1) = 3
      - Xe(7s[3/2]2) = 5
      - Xe(7s[3/2]1) = 3
      - Xe(7p[1/2]1) = 3
      - Xe(7p[5/2]2) = 5
      - Xe(6p![3/2]1) = 3
      - Xe(7p[5/2]3) = 7
      - Xe(6d[1/2]0) = 1
      - Xe(6d[1/2]1) = 3
      - Xe(7p[3/2]2) = 5
      - Xe(6d[3/2]2) = 5
      - Xe(7p[3/2]1) = 3
      - Xe(7p[1/2]0) = 1
      - Xe(6d[7/2]4) = 9
      - Xe(6d[7/2]3) = 7
      - Xe(6p![3/2]2) = 5
      - Xe(6d[5/2]2) = 5
      - Xe(6p![1/2]1) = 3
      - Xe(6d[5/2]3) = 7
      - Xe(6d[3/2]1) = 3
      - Xe(6p![1/2]0) = 1
      - Xe(8s[3/2]2) = 5
      - Xe(4f[3/2]1) = 3
      - Xe(4f[3/2]2) = 5
      - Xe(4f[9/2]4) = 9
      - Xe(4f[9/2]5) = 11
      - Xe(4f[5/2]2) = 5
      - Xe(4f[5/2]3) = 7
      - Xe(8s[3/2]1) = 3
      - Xe(4f[7/2]3) = 7
      - Xe(4f[7/2]4) = 9
      - Xe(5d![5/2]2) = 5
      - Xe(5d![3/2]2) = 5
      - Xe(5d![5/2]3) = 7
      - Xe(7d[1/2]1) = 3    % NOTE: double bracket is a typo in the original LXCat file; must match exactly
      - Xe(8p[1/2]1) = 3
      - Xe(8p[5/2]2) = 5
      - Xe(7d[1/2]0) = 1
      - Xe(8p[5/2]3) = 7
      - Xe(8p[3/2]1) = 3
      - Xe(8p[3/2]2) = 5
      - Xe(7d[7/2]4) = 9
      - Xe(8p[1/2]0) = 1
      - Xe(7d[7/2]3) = 7
      - Xe(7d[3/2]1) = 3
      - Xe(7d[5/2]2) = 5
      - Xe(7d[3/2]2) = 5
      - Xe(7d[5/2]3) = 7
      - Xe(9s[3/2]2) = 5
      - Xe(9s[3/2]1) = 3
      - Xe(5d![3/2]1) = 3
      - Xe(7s![1/2]0) = 1
      - Xe(7s![1/2]1) = 3
      - Xe(4f![7/2]4) = 9
      - Xe(4f![5/2]2) = 5
      - Xe(4f![7/2]3) = 7
      - Xe(4f![5/2]3) = 7
  numericsMC:
    nElectrons: 2E4
    gasTemperatureEffect: smartActivation
    nIntegrationPoints: 1E4
    nIntegratedSSTimes: 3

% --- configuration for the heavy species kinetics ---
chemistry:
  isOn: false

% --- configuration of the graphical user interface ---
gui: 
  isOn: true
  plotOptions:
    - MCTemporalInfo
    - MCTemporalInfo_periodic
    - distributionFunctions
    - swarmParameters
  terminalDisp:
    - setup
    - MCStatus

% ---  configuration of the output files ---
output: 
  isOn: true
  folder: swarm_Xe_BSR
  dataFiles:
    - eedf
%    - evdf
    - swarmParameters
    - rateCoefficients
    - powerBalance
%    - MCTemporalInfo
    - MCTemporalInfo_periodic
    - MCSimDetails
    - lookUpTable
